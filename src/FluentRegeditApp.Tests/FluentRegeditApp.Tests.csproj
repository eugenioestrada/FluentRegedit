<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FluentRegeditApp.Tests</RootNamespace>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <!-- xUnit v3 test projects are stand-alone executables. -->
    <OutputType>Exe</OutputType>
    <!-- Avoid pulling in WinUI / MSIX tooling from the main project. -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <UseWinUI>false</UseWinUI>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
  </ItemGroup>

  <!--
    The main project is a WinUI WinExe with MSIX tooling that doesn't build cleanly as
    a ProjectReference here. Instead, recompile only the testable Models and Services
    source files into this assembly so tests can exercise them without any XAML or
    WinUI dependency.
  -->
  <ItemGroup>
    <Compile Include="..\FluentRegeditApp\Models\**\*.cs">
      <Link>_FromApp\Models\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\FluentRegeditApp\Services\**\*.cs">
      <Link>_FromApp\Services\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
