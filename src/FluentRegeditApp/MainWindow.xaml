<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentRegeditApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentRegeditApp"
    xmlns:models="using:FluentRegeditApp.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FluentRegedit">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="OnRootDragOver"
          Drop="OnRootDrop"
          Padding="0" RowSpacing="0">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator" />
            <KeyboardAccelerator Key="F3" Invoked="OnFindNextAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="F2" Invoked="OnRenameAccelerator" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="OnPaletteAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnUpAccelerator" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnFocusPathAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Import .reg…" Click="OnImportClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe Fluent Icons" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem Text="Export current key">
                    <MenuFlyoutItem Text="As .reg (Unicode v5)…" Click="OnExportClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xEDE1;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="As .json…" Click="OnExportJsonClick" />
                    <MenuFlyoutItem Text="As .csv…" Click="OnExportCsvClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Backup current key" Click="OnBackupClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" FontFamily="Segoe Fluent Icons" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Manage backups…" Click="OnManageBackupsClick" />
                <MenuFlyoutItem Text="Open backups folder" Click="OnOpenBackupsClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="HiveMenu" Text="Hive (admin only)">
                    <MenuFlyoutItem Text="Save hive…" Click="OnSaveHiveClick" />
                    <MenuFlyoutItem Text="Load hive…" Click="OnLoadHiveClick" />
                    <MenuFlyoutItem Text="Unload selected hive" Click="OnUnloadHiveClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="OnExitClick" />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Undo" Click="OnUndoClick" x:Name="UndoMenuItem" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" IsEnabled="False" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE7A7;" FontFamily="Segoe Fluent Icons" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Find…" Click="OnSearchClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Find next" Click="OnFindNextClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Rename" Click="OnRenameClick" />
                <MenuFlyoutItem Text="Copy key path" Click="OnCopyPathClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="RecentMenu" Text="Recent locations" />
            </MenuBarItem>
            <MenuBarItem x:Name="FavoritesMenuBar" Title="Favorites">
                <MenuFlyoutItem Text="Add current key…" Click="OnAddFavoriteClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE734;" FontFamily="Segoe Fluent Icons" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Manage favorites…" Click="OnManageFavoritesClick" />
                <MenuFlyoutSeparator x:Name="FavoritesSeparator" />
                <!-- Dynamic favorite items appended at runtime -->
            </MenuBarItem>
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="ViewDefaultItem" Text="Default view" Click="OnViewModeClick" Tag="Default" />
                <ToggleMenuFlyoutItem x:Name="View32Item" Text="32-bit view" Click="OnViewModeClick" Tag="Registry32" />
                <ToggleMenuFlyoutItem x:Name="View64Item" Text="64-bit view" Click="OnViewModeClick" Tag="Registry64" />
            </MenuBarItem>
            <MenuBarItem Title="Tools">
                <MenuFlyoutItem Text="Command palette…" Click="OnPaletteClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE756;" FontFamily="Segoe Fluent Icons" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Settings…" Click="OnSettingsClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <!-- Path bar -->
        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Click="OnBackClick" IsEnabled="False"
                    ToolTipService.ToolTip="Back (Alt+Left)">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Click="OnForwardClick" IsEnabled="False"
                    ToolTipService.ToolTip="Forward (Alt+Right)">
                <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="14" />
            </Button>
            <Button x:Name="UpButton" Grid.Column="2" Click="OnUpClick"
                    ToolTipService.ToolTip="Up one level (Alt+Up)">
                <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="14" />
            </Button>
            <TextBox x:Name="PathBox" Grid.Column="3" PlaceholderText="HKLM\Software\Microsoft  —  type a path and press Enter"
                     KeyDown="OnPathBoxKeyDown" />
            <Button x:Name="RefreshButton" Grid.Column="4" Click="OnRefreshClick"
                    ToolTipService.ToolTip="Refresh (F5)">
                <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" />
            </Button>
            <Button x:Name="SearchButton" Grid.Column="5" Click="OnSearchClick"
                    ToolTipService.ToolTip="Find (Ctrl+F)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                    <TextBlock Text="Find" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Toast -->
        <InfoBar x:Name="Toast" Grid.Row="2" IsOpen="False" Margin="12,0,12,0" />

        <!-- Main area -->
        <Grid Grid.Row="3" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Tree -->
            <Border Grid.Column="0" BorderThickness="0,1,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <TreeView x:Name="KeysTree"
                          ItemsSource="{x:Bind ViewModel.Roots, Mode=OneWay}"
                          SelectionMode="Single"
                          ItemInvoked="OnTreeItemInvoked"
                          Expanding="OnTreeExpanding"
                          SelectionChanged="OnTreeSelectionChanged">
                    <TreeView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="New subkey…" Click="OnNewKeyClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Rename" Click="OnRenameKeyClick" />
                            <MenuFlyoutItem Text="Delete key" Click="OnDeleteKeyClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Backup this key" Click="OnBackupClick" />
                            <MenuFlyoutItem Text="Export this key…" Click="OnExportClick" />
                            <MenuFlyoutItem Text="Add to favorites" Click="OnAddFavoriteClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Copy key path" Click="OnCopyPathClick" />
                        </MenuFlyout>
                    </TreeView.ContextFlyout>
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="models:RegistryKeyNode">
                            <TreeViewItem ItemsSource="{x:Bind Children}"
                                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                              Opacity="0.8" />
                                    <TextBlock Text="{x:Bind Name}" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- Values -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Quick filter -->
                <Grid Grid.Row="0" Padding="12,8,12,4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ValueFilterBox" Grid.Column="0"
                             PlaceholderText="Filter values (name, type or data)"
                             TextChanged="OnValueFilterChanged" />
                    <Button Grid.Column="1" Click="OnClearFilterClick" ToolTipService.ToolTip="Clear filter">
                        <FontIcon Glyph="&#xE894;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Padding="12,8" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="3*" MinWidth="160" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Data" FontWeight="SemiBold" />
                </Grid>

                <ListView Grid.Row="2"
                          x:Name="ValuesList"
                          ItemsSource="{x:Bind ViewModel.Values, Mode=OneWay}"
                          SelectionMode="Single"
                          DoubleTapped="OnValueDoubleTapped">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="New value…" Click="OnNewValueClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Modify…" Click="OnModifyValueClick" />
                            <MenuFlyoutItem Text="Rename" Click="OnRenameValueClick" />
                            <MenuFlyoutItem Text="Delete" Click="OnDeleteValueClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Copy value name" Click="OnCopyValueNameClick" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:RegistryValueItem">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="3*" MinWidth="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                              Opacity="0.7" />
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind KindDisplay}" Opacity="0.85" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DataDisplay}"
                                           TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Padding="12,6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusPathText" Grid.Column="0" Opacity="0.8"
                           TextTrimming="CharacterEllipsis"
                           Text="Computer" />
                <TextBlock x:Name="StatusViewText" Grid.Column="1" Opacity="0.65" Text="" />
                <TextBlock x:Name="StatusCountText" Grid.Column="2" Opacity="0.8" Text="" />
            </Grid>
        </Border>
    </Grid>
</Window>
