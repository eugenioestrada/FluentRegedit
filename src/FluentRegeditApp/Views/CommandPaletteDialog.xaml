<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FluentRegeditApp.Views.CommandPaletteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Command palette"
    CloseButtonText="Close">
    <Grid Width="540" Height="420" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" x:Name="QueryBox" PlaceholderText="Type to filter…"
                 TextChanged="OnQueryChanged" KeyDown="OnQueryKey" />

        <ListView Grid.Row="1" x:Name="ResultsList" SelectionMode="Single"
                  IsItemClickEnabled="True" ItemClick="OnItemClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="0,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
