<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="FluentRegeditApp.Views.SearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:FluentRegeditApp.Services"
    Title="Find in registry"
    PrimaryButtonText="Go to"
    CloseButtonText="Close"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <Grid RowSpacing="12" Width="640">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" Grid.Column="0"
                     PlaceholderText="Search query"
                     KeyDown="OnQueryKeyDown" />
            <Button x:Name="StartButton" Grid.Column="1" Content="Find" Click="OnFindClick"
                    Style="{ThemeResource AccentButtonStyle}" />
            <Button x:Name="CancelButton" Grid.Column="2" Content="Stop" Click="OnStopClick"
                    IsEnabled="False" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="OptKeys" Content="Keys" IsChecked="True" />
            <CheckBox x:Name="OptValueNames" Content="Value names" IsChecked="True" />
            <CheckBox x:Name="OptValueData" Content="Value data" IsChecked="True" />
            <CheckBox x:Name="OptCase" Content="Case sensitive" />
            <CheckBox x:Name="OptWhole" Content="Match whole string" />
            <CheckBox x:Name="OptRegex" Content="Regex" />
        </StackPanel>

        <TextBlock x:Name="ScopeText" Grid.Row="2" Opacity="0.8" />

        <ListView x:Name="ResultsList" Grid.Row="3"
                  SelectionChanged="OnResultsSelectionChanged"
                  DoubleTapped="OnResultsDoubleTapped"
                  BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:SearchHit">
                    <StackPanel Spacing="2" Padding="4,2">
                        <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind KindDisplay}" Opacity="0.6" FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="StatusText" Grid.Row="4" Opacity="0.8" Text="Ready." />
    </Grid>
</ContentDialog>
